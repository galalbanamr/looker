# Competition Monitor - Environment Variables
# Copy this file to .env.production and fill in the values

# ===================
# Database (PostgreSQL)
# ===================
# When running with Docker Compose, use the service name 'postgres'
DATABASE_URL=postgresql://competition:competition123@postgres:5432/competition_monitor

# ===================
# Redis (for BullMQ)
# ===================
REDIS_HOST=redis
REDIS_PORT=6379

# ===================
# API Configuration
# ===================
PORT=4100
NODE_ENV=production

# ===================
# Frontend URL
# ===================
# Using Cloudflare Tunnel Domain
FRONTEND_URL=https://car-scan.qa

# ===================
# Cloudflare Tunnel
# ===================
# Token for car-scan.qa (be2b859c-4196-4b3c-b24d-a633ce65c21a)
# Base64 encoded credentials
TUNNEL_TOKEN=e1wgQWNjb3VudFRhZ1w6XDQ3ZmUyNGE5NjA2OTI1MDJkNjBhNjI1ZTk3NzE3N2Q5XCxcVHVubmVsU2VjcmV0XDpcdTdsYWdHTmUzMjQzV3FLSnFZNUs3Nnd5ZXd0WGN4Wm0wOW9QTmRJZDF4RT1cLFxUdW5uZWxJRFw6XGJlMmI4NTljLTQxOTYtNGIzYy1iMjRkLWE2MzNjZTY1YzIxYVwsXEVuZHBvaW50XDpcXH0=

# ===================
# Firebase Configuration
# ===================
# Option 1: Base64-encoded service account JSON
# Generate with: cat firebase-service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 2: Path to service account file (if mounting as volume)
# GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# ===================
# WhatsApp Configuration
# ===================
WHATSAPP_SESSION_DIR=/app/whatsapp-sessions

# ===================
# Optional: External Services
# ===================
# Perplexity API (if using)
# PERPLEXITY_API_KEY=

# ===================
# Optional: Monitoring
# ===================
# LOG_LEVEL=info
